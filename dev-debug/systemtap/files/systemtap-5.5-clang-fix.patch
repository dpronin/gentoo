+fd_streambuf::fd_streambuf(int fd, std::ios_base::openmode mode, size_t bufsize)
+  : fd(fd), mode(mode), buf(bufsize > 0 ? bufsize : BUFSIZ)
+{
+  if (mode & std::ios_base::in)
+    setg(buf.data(), buf.data(), buf.data());
+  if (mode & std::ios_base::out)
+    setp(buf.data(), buf.data() + buf.size());
+}
+
+fd_streambuf::~fd_streambuf()
+{
+  close();
+}
+
+bool
+fd_streambuf::flush_out()
+{
+  if (fd < 0 || !(mode & std::ios_base::out))
+    return true;
+  char *p = pbase();
+  char *end = pptr();
+  while (p < end)
+    {
+      ssize_t n = ::write(fd, p, static_cast<size_t>(end - p));
+      if (n < 0)
+        {
+          if (errno == EINTR)
+            continue;
+          return false;
+        }
+      p += n;
+    }
+  setp(buf.data(), buf.data() + buf.size());
+  return true;
+}
+
+std::streambuf::int_type
+fd_streambuf::underflow()
+{
+  if (fd < 0 || !(mode & std::ios_base::in))
+    return traits_type::eof();
+  if (gptr() < egptr())
+    return traits_type::to_int_type(*gptr());
+  ssize_t n;
+  do
+    n = ::read(fd, buf.data(), buf.size());
+  while (n < 0 && errno == EINTR);
+  if (n <= 0)
+    return traits_type::eof();
+  setg(buf.data(), buf.data(), buf.data() + n);
+  return traits_type::to_int_type(*gptr());
+}
+
+std::streambuf::int_type
+fd_streambuf::overflow(int_type c)
+{
+  if (!flush_out())
+    return traits_type::eof();
+  if (!traits_type::eq_int_type(c, traits_type::eof()))
+    {
+      *pptr() = traits_type::to_char_type(c);
+      pbump(1);
+    }
+  return traits_type::not_eof(c);
+}
+
+int
+fd_streambuf::sync()
+{
+  return flush_out() ? 0 : -1;
+}
+
+int
+fd_streambuf::close()
+{
+  if (fd < 0)
+    return 0;
+  int rc = flush_out() ? 0 : -1;
+  int closed = ::close(fd);
+  fd = -1;
+  return (rc == 0 && closed == 0) ? 0 : -1;
+}
 
 
